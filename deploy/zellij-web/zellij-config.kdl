web_server_ip "127.0.0.1"
web_server_port 8082

web_client {
    base_url "/zellij"
    cursor_blink true
    cursor_style "block"
    cursor_inactive_style "outline"
    theme {
        background 8 8 10
        foreground 228 228 231
        bright_green 118 185 0
        cursor 118 185 0
        selection_background 39 39 42
    }
}

// Browser-friendly mode selectors. Ctrl-based shortcuts remain available in
// non-normal modes, while normal terminal input can use Ctrl combinations
// without Zellij intercepting them.
keybinds {
    normal clear-defaults=true {
        bind "Alt p" { SwitchToMode "pane"; }
        bind "Alt t" { SwitchToMode "tab"; }
        bind "Alt r" { SwitchToMode "resize"; }
        bind "Alt s" { SwitchToMode "scroll"; }
        bind "Alt o" { SwitchToMode "session"; }
        bind "Alt g" { SwitchToMode "locked"; }
        bind "Alt n" { NewPane; }
        bind "Alt h" "Alt Left" { MoveFocusOrTab "Left"; }
        bind "Alt l" "Alt Right" { MoveFocusOrTab "Right"; }
        bind "Alt j" "Alt Down" { MoveFocus "Down"; }
        bind "Alt k" "Alt Up" { MoveFocus "Up"; }
        bind "Alt +" "Alt =" { Resize "Increase"; }
        bind "Alt -" { Resize "Decrease"; }
    }
    locked {
        bind "Alt g" { SwitchToMode "normal"; }
    }
}
